generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id          Int          @id @default(autoincrement())
  telegramId  String       @unique
  username    String?
  firstName   String
  lastName    String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  // Реферальная программа — «сваты»
  referrerId            Int?
  referrer              User?    @relation("Referrals", fields: [referrerId], references: [id])
  referrals             User[]   @relation("Referrals")
  referralBonusGranted  Boolean  @default(false)
  // Payload из `/start ref_X` — сохраняется ботом и подхватывается /api/game.
  // Нужно потому, что Telegram доставляет start_param в WebApp initData только
  // если у бота настроена Main Mini App в BotFather. Через команду бота — надёжнее.
  pendingReferralParam  String?
  nickname              String?
  utmSource             String?   // источник первого входа: utm_gk, utm_cm и т.д.

  // Может ли бот доставить юзеру сообщение через sendMessage. False ставится
  // автоматически в рассылке при ошибках not_found / blocked / deactivated /
  // kicked / forbidden_other — это «постоянные» провалы, нет смысла бить туда
  // снова. Возвращается в true при /start (например, юзер разблокировал бота).
  // Источник проблемы: боты с купленного трафика регистрировались через
  // Mini App без `/start` боту → 96% not_found на /broadcastall.
  canReceiveBroadcast    Boolean   @default(true)

  gameState      GameState?
  projects       Project[]
  amaSessions    AmaSession[]
  updates        DailyUpdate[]
  postMortems    PostMortem[]
  transactions   Transaction[]
  channelClaims  ChannelClaim[]
  starPurchases  StarPurchase[]
  chatMessages   ChatMessage[]
}

model GameState {
  id                   Int       @id @default(autoincrement())
  userId               Int       @unique
  balance              Float     @default(0)
  currentDay           Int       @default(0)
  investorRank         String    @default("NEWBIE")
  intuitionScore       Int       @default(0)
  scamsDetected        Int       @default(0)
  scamsMissed          Int       @default(0)
  dayStreak            Int       @default(0)
  isOnboardingComplete Boolean   @default(false)
  totalInvested        Float     @default(0)
  totalReturned        Float     @default(0)
  balanceHistory       Float[]   @default([])
  investedHistory      Float[]   @default([])
  pendingRankUp        String?
  preferredModel       String    @default("deepseek/deepseek-v4-flash")
  preferredLanguage    String    @default("ru")
  // Игрок выключил ежедневные AI-новости — экономит токены OpenRouter и
  // время игрока. Значения дел (доходность, число вкладчиков) при этом
  // меняются как обычно, просто без сопроводительного текста.
  newsEnabled          Boolean   @default(true)
  lastAdvancedAt       DateTime?
  // Флаг: отправлено ли уведомление о доступности следующего дня для текущего lastAdvancedAt.
  // Сбрасывается в false при advance-day, ставится в true в cron'е, когда уведомление отправлено.
  // Default true чтобы не спамить юзеров, у которых lastAdvancedAt уже давно прошёл.
  nextDayNotified      Boolean   @default(true)
  // Сколько дней игрок прошёл подряд без ожидания кулдауна.
  // Сбрасывается в 1 после 2ч-ожидания или после просмотра рекламы.
  // После 3-го подряд — кнопка «Следующий день» блокируется на 2 часа или разблокируется рекламой.
  consecutiveAdvances  Int       @default(0)
  // Снимок состояния на начало текущей «ярмарочной недели» — для недельного лидерборда.
  // Обновляется при первом обращении после нового понедельника МСК.
  weekStartWealth      Float     @default(0)
  weekStartAt          DateTime?
  timerSkipTokens      Int       @default(0)
  extraSlotsBalance    Int       @default(0)
  // Дневные стрики (вкладка «Сегодня») — независимы от dayStreak (тот считает
  // быстрые нажатия «Следующий день»). Сбрасываются если игрок пропустил день.
  loginStreak          Int       @default(0)
  lastSeenDay          String?   // YYYY-MM-DD в МСК — когда стрик последний раз обновлялся
  lastDailyClaim       String?   // YYYY-MM-DD — день последнего получения награды
  // Жетоны-монеты по архетипам хозяев. Заработок: каждые 10 сыгранных
  // мини-игр + каждые 5 взятых дел = 1 жетон. Тратится на бесплатную
  // беседу с тем же хозяином или раскрытие дела при провале мини-игры.
  // Заработок считается на лету из minigameSessions/projects, в БД
  // храним только сколько потрачено. Map<archetype, count>.
  archetypeTokensSpent Json      @default("{}")
  // Внеочередное объявление о группе купцов — показывается один раз
  marketAnnouncementSeen          Boolean   @default(false)
  marketAnnouncementRewardClaimed Boolean   @default(false)
  updatedAt            DateTime  @updatedAt

  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Типы проектов (соответствуют Android-энаму ProjectType)
// CARD_GAME | TREASURE_HUNT | POTION_BREW | GUILD_SCHEME | HONEST_TRADE

// Судьбы (ProjectFate)
// INSTANT_SCAM | SLOW_DRAIN | HONEST_FAIL | SURVIVOR | UNICORN

// Архетипы (PersonaArchetype)
// BURATINO | BOYARIN | KOLOBOK | KOSCHEI | ZOLUSHKA | BABA_YAGA | IVAN_DURAK

// LieTopic
// PATRON_COUNT | DAILY_PROFIT | PAYOUT_DATE | GUILD_SIZE | ELDER_BLESSING | NOBLE_BACKING | WITHDRAWAL_LIMITS

model Project {
  id                   String    @id @default(uuid())
  userId               Int
  name                 String
  type                 String    // ProjectType

  // Статус в игре
  isInbox              Boolean   @default(true)
  isActive             Boolean   @default(false)
  isClosed             Boolean   @default(false)
  // Преgenerированное дело — ждёт следующего advance-day, когда попадёт в inbox.
  // Позволяет AI успеть написать имя/описание во время 2-часового кулдауна,
  // чтобы новые грамоты появлялись мгновенно.
  isPreloaded          Boolean   @default(false)

  // СКРЫТЫЕ поля — НИКОГДА не отдавать клиенту до закрытия
  fate                 String    // ProjectFate
  personaArchetype     String    // PersonaArchetype
  daysUntilCollapse    Int?
  realDailyYieldRubles Float
  lieTopics            String[]  @default([]) // LieTopic[]
  truthTopics          String[]  @default([]) // LieTopic[]
  npcTruthParams       Json?                  // NpcTruthParams — реальные факты для промпта

  // ПУБЛИЧНЫЕ поля — видит игрок
  developerName        String
  developerAvatarSeed  String
  claimedName          String
  claimedAPY           Float
  claimedUserCount     Int
  claimedTeamSize      Int
  description          String    @db.Text
  roadmap              String[]  @default([])

  // СОСТОЯНИЕ
  investedAmountRubles Float     @default(0)
  currentValueRubles   Float     @default(0)
  totalWithdrawnRubles Float     @default(0)  // сумма всех выводов (после комиссии) — для корректного profit%
  daysSinceJoined      Int       @default(0)
  isWithdrawalLocked   Boolean   @default(false)
  // «Предложение от которого нельзя отказаться» — за 2-3 дня до автозакрытия
  // прибыльных дел (SURVIVOR/UNICORN). Если игрок не успел выйти руками —
  // получит 50% при автозакрытии. См. mafiaOffers.ts.
  mafiaOfferIssued     Boolean   @default(false)
  isExtraSlot          Boolean   @default(false)
  closureReason        String?
  bannerImageUrl       String?
  bannerPromptUsed     String?

  // VIP-дело от спонсорского канала. Если isSponsor=true, поля ниже:
  //   - promocode: секретное слово, которое игрок должен ввести вместо
  //     прохождения мини-игры. Сравнение case-insensitive.
  //   - sponsorChannelUrl: ссылка на канал, где промокод опубликован.
  //   - sponsorCampaignId: ссылка на исходную кампанию (для аналитики).
  //   - sponsorPromoVerified: true когда игрок ввёл правильный промокод.
  // Финал такого дела: фиксированный возврат 3× за durationDays.
  isSponsor             Boolean   @default(false)
  promocode             String?
  sponsorChannelUrl     String?
  sponsorCampaignId     String?
  sponsorPromoVerified  Boolean   @default(false)

  // История для графиков (хранить компактно — последние 30 дней)
  currentUserCount     Int       @default(0)
  userCountHistory     Int[]     @default([])
  apyHistory           Float[]   @default([])
  valueHistory         Float[]   @default([])

  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  amaSession           AmaSession?
  updates              DailyUpdate[]
  postMortem           PostMortem?

  @@index([userId, isActive])
  @@index([userId, isInbox])
}

model AmaSession {
  id                    String       @id @default(uuid())
  projectId             String       @unique
  userId                Int
  questionCount         Int          @default(0)
  isComplete            Boolean      @default(false)
  isIntuitionEvaluated  Boolean      @default(false)
  selectedLieTopics     String[]     @default([]) // выбранные игроком подозрения (legacy AI-чат)
  intuitionDelta        Int          @default(0)  // итоговый результат оценки

  // Мини-игра «Купеческая грамота» — SKRYTYE от клиента поля помечены
  gridSeed              String?      // seed для процедурной генерации печатей
  gridSize              Int          @default(0)
  difficulty            String?      // EASY | MEDIUM | HARD — сила мутации подделок
  forgedIndices         Int[]        @default([]) // СКРЫТО: индексы поддельных печатей
  charterSelectedIndices Int[]       @default([]) // что отметил игрок при сабмите
  // Игрок начал саму игру (нажал «Принять испытание»). После этого
  // F5 в браузере считается провалом — защита от перепрохождения с тем же seed.
  gridStartedAt         DateTime?
  charterSubmittedAt    DateTime?

  isPaid                Boolean      @default(false)
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt

  project               Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user                  User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages              AmaMessage[]
}

model AmaMessage {
  id        Int        @id @default(autoincrement())
  sessionId String
  role      String     // "user" | "assistant"
  content   String     @db.Text
  createdAt DateTime   @default(now())

  session   AmaSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
}

model DailyUpdate {
  id             Int      @id @default(autoincrement())
  projectId      String
  userId         Int
  day            Int
  title          String
  body           String   @db.Text
  redFlags       String[] @default([])
  payoutStatus   String   @default("NORMAL") // NORMAL | DELAYED | BOOSTED
  announcement   String?  // LISTING | HACK | CRIMINAL_CASE | PARTNERSHIP | null
  // Случайное событие (см. randomEvents.ts) — для UI-подсветки в ленте новостей.
  // null = обычная ежедневная весть; NEGATIVE/POSITIVE/NEUTRAL = выпало событие.
  eventKind      String?  // NEGATIVE | POSITIVE | NEUTRAL | null
  userCountDelta Int      @default(0)
  createdAt      DateTime @default(now())

  project        Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([userId])
}

model PostMortem {
  id               Int      @id @default(autoincrement())
  projectId        String   @unique
  userId           Int
  revealedArchetype String  // PersonaArchetype
  fate             String   // ProjectFate
  lieTopics        String[] @default([])
  analysis         String   @db.Text
  investedAmount   Float
  returnedAmount   Float
  profitPercent    Float    // может быть отрицательным
  daysActive       Int
  lieGuessCorrect  Boolean  @default(false)
  intuitionDelta   Int      @default(0)
  createdAt        DateTime @default(now())

  project          Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Transaction {
  id          Int      @id @default(autoincrement())
  userId      Int
  projectId   String?
  projectName String
  type        String   // INVEST | ADD | WITHDRAW | EXIT | RETURNED
  amount      Float
  day         Int      @default(0)
  createdAt   DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Клейм за подписку на канал — одна строка на (user, taskId)
model ChannelClaim {
  id        Int      @id @default(autoincrement())
  userId    Int
  taskId    String
  claimedAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, taskId])
  @@index([userId])
}

// Покупки за Telegram Stars
model StarPurchase {
  id               Int      @id @default(autoincrement())
  userId           Int
  feature          String   // "timer_skip" | "ama_unlock"
  projectId        String?
  starsAmount      Int      @default(10)
  telegramChargeId String?
  payload          String   @unique
  createdAt        DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Для монетизации (трекинг дохода от рекламы)
model AdRevenue {
  id        Int      @id @default(autoincrement())
  source    String   // "yandex" | "telegram" | "manual"
  amount    Float    // в рублях
  currency  String   @default("RUB")
  meta      String?  // JSON: доп. данные от рекламной сети
  recordedAt DateTime @default(now())
}

// VIP-дела от спонсорских каналов. Появляются в инбоксе вместо обычных дел
// с шансом SPONSOR_CHANCE (см. types.ts). Если активных кампаний несколько —
// выбирается случайная (по весам weight). Дело имеет фиксированный возврат
// SPONSOR_PROFIT_MULT (3×) за durationDays дней без судьбы скама.
//
// Управляется через бот: /sponsor add | list | remove (только ADMIN_TELEGRAM_ID).
model SponsorCampaign {
  id              String   @id @default(uuid())
  channelName     String                                       // «@MyChannel»
  channelUrl      String                                       // https://t.me/MyChannel
  promocode       String                                       // секретное слово
  scenarioTitle   String                                       // «Воеводская награда» (название дела)
  scenarioBody    String   @db.Text                            // текст описания дела (сказочный)
  developerName   String                                       // «Воевода Михайло»
  archetype       String                                       // PersonaArchetype (для баннера)
  type            String                                       // ProjectType
  durationDays    Int      @default(14)
  bannerImageUrl  String?                                      // null = заглушка SPONSOR_VIP_01.webp
  active          Boolean  @default(true)                      // false = больше не выпадает
  weight          Int      @default(10)                        // вес в случайном выборе
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model ChatMessage {
  id                 Int      @id @default(autoincrement())
  userId             Int
  displayName        String
  investorRank       String   @default("NEWBIE")
  text               String   @db.Text
  isDeleted          Boolean  @default(false)
  replyToId          Int?
  replyToText        String?  @db.Text
  replyToDisplayName String?
  createdAt          DateTime @default(now())

  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@index([userId])
}

// Архив сезонов: финальный топ-100 каждого рейтинга на момент закрытия
// сезона. Хранится JSON-блобом в той же форме, что отдают эндпоинты
// `/api/leaderboard/*`, чтобы при включении ARCHIVE_SEASON_VIEW env-var
// серверу не нужно было пересчитывать ничего — просто отдать сохранённое.
// Заполняется бот-командой /snapshot_season <N> ДО /resetall.
model SeasonArchive {
  id            Int      @id @default(autoincrement())
  seasonNumber  Int
  category      String   // 'WEALTH' | 'TIES' | 'ACHIEVEMENTS' | 'REFERRALS' | 'WEALTH_TODAY'
  totalPlayers  Int
  entries       Json
  capturedAt    DateTime @default(now())

  @@unique([seasonNumber, category])
}
