DATABASE_URL="postgresql://user:password@localhost:5432/from0tolamba"
TELEGRAM_BOT_TOKEN="123456:ABC-DEF..."
MINI_APP_URL="https://xxx.bothost.tech"
OPENROUTER_API_KEY="sk-or-..."
# Pollinations.ai — генерация баннеров. Без ключа работает анонимно (медленнее, без приоритета).
POLLINATIONS_API_KEY=""
# Модель для image API: flux (default), flux-realism, turbo и др. — см. свой ключ на pollinations.ai
POLLINATIONS_MODEL="flux"
ADMIN_JWT_SECRET="change-me-in-production"
PORT=3000
NODE_ENV=development
# Включить реальные Telegram Stars-платежи (true в prod, false/omit в dev — бесплатный режим)
PAYMENTS_ENABLED=false
# TON-адрес для приёма донатов (кнопка «Поддержать разработчика 0.1 TON»).
# Если не задан — кнопка доната не показывается. Формат EQ.../UQ... или 0:hex.
TON_DONATE_ADDRESS=""
# Telegram Apps Analytics (требование каталога tApps). Получить токен у
# @DataChief_bot. appName — короткий идентификатор приложения (slug).
# Кладутся в Vite-клиент через переменные с префиксом VITE_:
#   VITE_TG_ANALYTICS_TOKEN
#   VITE_TG_ANALYTICS_APP
# В Railway → Variables. Без них SDK просто не инициализируется.
