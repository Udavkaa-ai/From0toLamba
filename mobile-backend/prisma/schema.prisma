generator client {
  provider      = "prisma-client-js"
  // native — для локальной разработки; musl-таргет — для Alpine-образа
  // Railway, иначе движок не грузится на musl libc.
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Купеческий рейтинг: одна запись на игрока (playerId — стабильный UUID
// с устройства). Обновляется upsert-ом при заходе/смене дня. Заодно по
// updatedAt видно, сколько тестеров реально играет и когда заходили.
model Merchant {
  playerId    String   @id
  nickname    String
  wealth      Float    @default(0)
  rankTitle   String?  // чин: Скоморох / Купец / … / Князь
  day         Int      @default(0)
  loginStreak Int      @default(0)
  appVersion  String?
  platform    String   @default("android")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([wealth])
  @@index([updatedAt])
}

// Общий игровой чат. Постоянный, для всех игроков. Модерация: жалобы
// копят reportCount, при пороге сообщение авто-скрывается; владелец
// разбирает на /admin/chat?key=... (скрыть/показать/удалить).
model ChatMessage {
  id          Int      @id @default(autoincrement())
  playerId    String   // стабильный id автора (тот же, что в рейтинге)
  nickname    String
  text        String
  replyToId   Int?     // ответ на другое сообщение
  deleted     Boolean  @default(false) // мягкое удаление автором/модератором
  hidden      Boolean  @default(false) // скрыто модерацией/автоскрытием
  reportCount Int      @default(0)
  createdAt   DateTime @default(now())

  @@index([createdAt])
  @@index([hidden])
}

// Заметки тестеров Android-версии.
// Выгрузка: страница /admin/feedback?key=... или SQL.
model Feedback {
  id         Int      @id @default(autoincrement())
  nickname   String?
  type       String   // BUG | SUGGESTION | QUESTION
  page       String?  // экран-источник (route)
  message    String
  appVersion String?
  platform   String   @default("android")
  device     String?  // производитель + модель, напр. «Samsung SM-G991B»
  androidSdk Int?     // уровень API Android (Build.VERSION.SDK_INT)
  screen     String?  // разрешение экрана, напр. «1080×2340 @2.75x»
  screenshot String?  // JPEG в base64 (без data-url), null — без картинки
  createdAt  DateTime @default(now())

  @@index([type])
  @@index([createdAt])
}
