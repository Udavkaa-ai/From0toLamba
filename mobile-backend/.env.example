# Переменные окружения mobile-backend (в Railway → Variables этого сервиса)

# Своя маленькая Postgres этого сервиса (НЕ база TG-игроков!)
DATABASE_URL=${{Postgres.DATABASE_URL}}

# Ключ OpenRouter — живёт только здесь, в APK не попадает
OPENROUTER_API_KEY=sk-or-...

# Общий секрет допуска (тот же вписать в GitHub Secret MOBILE_APP_KEY)
MOBILE_APP_KEY=<длинная случайная строка, openssl rand -hex 32>

# Необязательно: Referer для OpenRouter-статистики
# APP_REFERER=https://your-mobile-backend.up.railway.app
